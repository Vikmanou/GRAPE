{
  "name": "grape",
  "private": true,
  "description": "Browser viewer for genome assembly graphs, rendered on the GPU",
  "repository": "github:Vikmanou/GRAPE",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "node scripts/build-wasm.mjs --dev && npm run dev -w web",
    "build": "node scripts/build-wasm.mjs && npm run build -w web",
    "check": "node scripts/check.mjs",
    "check:quick": "node scripts/check.mjs --quick",
    "check:headed": "node scripts/check.mjs --headed",
    "format": "cargo fmt --all && prettier --write .",
    "fuzz": "node scripts/fuzz.mjs",
    "bench:parse": "node scripts/bench-parse.mjs",
    "samples": "node scripts/fetch-samples.mjs",
    "bench:layout": "node scripts/bench-layout.mjs"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
